{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "obsv-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "obsv-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && set -a && . ./.env && set +a && exec npm start"],
      "port": 3000
    }
  ]
}
